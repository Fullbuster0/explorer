# rename to .env.local or .env.<your_environment>

# Refresh interval for the app to query api for new blocks
VITE_REFRESH_INTERVAL=6000

# Enable fetching all blocks (this can increase api calls to public nodes resulting in rate limiting)
VITE_FETCH_ALL_BLOCKS=false

# Limit for recent blocks and associated transactions displayed in the UI
VITE_RECENT_BLOCK_LIMIT=50

# Market API root. Production uses the Shazoes cache; direct CoinGecko remains
# supported for local fallback/testing.
VITE_COINGECKO_URL=https://api.shazoes.xyz

# GITHUB_API_URL default
VITE_GITHUB_API_URL=https://api.github.com/repos/cosmos/chain-registry/contents

# PINGPUB_API_URL default
VITE_PINGPUB_API_URL=https://registry.ping.pub

# IBC use PINGPUB_API_URL by Default (false) or GITHUB_API_URL (true)
VITE_IBC_USE_GITHUB_API=false

# Shazoes vote-indexer (separate from Vercel SPA). Reconstructs per-voter
# Yes/No/Abstain from MsgVote tx queries.
# Default (unset): same-origin /vote-api via vercel.json rewrite → VPS:8878
# Absolute override: https://vote-tendermint.shazoes.xyz
# Disable indexer (LCD only): set to empty string VITE_VOTE_INDEXER_URL=
# VITE_VOTE_INDEXER_URL=

# Shazoes tx-indexer (VPS:8879). Serves the newest 100 txs per chain for the
# "Recent Transactions" feed. Primary source; falls back to the live LCD walk
# when unreachable. Public LCDs reject `query=tx.height>0` on most chains, which
# is why the indexer exists.
# Default (unset): https://tx-indexer.shazoes.xyz (direct; CORS + CF-real-IP)
# Same-origin path via vercel.json rewrite: VITE_TX_INDEXER_URL=/tx-api
# Disable indexer (LCD only): set to empty string VITE_TX_INDEXER_URL=
# VITE_TX_INDEXER_URL=
