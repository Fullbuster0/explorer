{
  "buildCommand": "yarn build-only",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "yarn install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/tx-api/:path*",
      "destination": "https://tx-indexer.shazoes.xyz/:path*"
    },
    {
      "source": "/vote-api/:path*",
      "destination": "https://vote-tendermint.shazoes.xyz/:path*"
    },
    {
      "source": "/archive-proxy/cosmoshub/:path*",
      "destination": "https://api.cosmoshub-4-archive.citizenweb3.com/:path*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|facebot|twitterbot|linkedinbot|discordbot|telegrambot|whatsapp|slackbot|embedly|quora|pinterest|redditbot|applebot|bingpreview|yandex|baidu|duckduck|ia_archiver|semrush|ahrefs|mj12bot|dotbot|petalbot).*"
        }
      ],
      "destination": "/api/og?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss: data:; frame-src 'self' https://wallet.keplr.app; worker-src 'self' blob:; child-src 'self' blob:; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
