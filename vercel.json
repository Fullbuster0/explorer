{
  "buildCommand": "yarn build-only",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "yarn install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/vote-api/:path*",
      "destination": "https://discussions-suite-reputation-mono.trycloudflare.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
